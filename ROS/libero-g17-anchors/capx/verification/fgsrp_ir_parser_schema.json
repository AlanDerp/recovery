{
  "schema_version": "capx-fgsrp-ir-parser-v2",
  "claim_ledger": [
    {
      "chunk_id": "exact candidate chunk identifier",
      "sentence_index": 0,
      "sentence_text": "exact host-provided sentence text",
      "claims": [
        {
          "original_claim": "exact atomic claim substring",
          "claim_type": "physical | non_editable | unknown",
          "assertions": [
            {
              "temporal_scope": "before | after | transition",
              "predicate": "ontology predicate identifier",
              "subject_entity_id": "entity registry identifier",
              "subject_text": "exact grammatical-subject substring",
              "referenced_entity_ids": ["ordered predicate entity identifiers"],
              "asserted_value": null,
              "asserted_changed": null,
              "asserted_before_value": null,
              "asserted_after_value": null
            }
          ]
        }
      ]
    }
  ],
  "audit": {
    "all_candidate_chunks_checked": true,
    "every_sentence_listed_once": true,
    "every_atomic_claim_parsed": true,
    "parsed_without_current_gt_values": true,
    "all_physical_subjects_bound": true,
    "contains_action_advice": false
  }
}
