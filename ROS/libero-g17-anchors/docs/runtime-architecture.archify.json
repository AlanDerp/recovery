  "cards": [
    {
      "dot": "cyan",
      "title": "启动入口",
      "items": [
        "uv run capx/envs/launch.py --config-path <yaml>；--web-ui True 打开 :8200",
        "感知服务由 YAML api_servers 自动拉起，或 launch_servers.py --profile 预启动"
      ]
    },
    {
      "dot": "emerald",
      "title": "评估路径",
      "items": [
        "runner 按 num_workers 复用环境；Web UI 走 async_trial_runner.py，是另一条路径",
        "experiments/ 与 scripts/sbatch_*.sh 只是同一入口的批作业包装"
      ]
    },
    {
      "dot": "amber",
      "title": "持久化边界",
      "items": [
        "仅当 output_dir 存在才落盘：code.py / summary.txt / all_responses.json / MP4",
        "目录名编码结果 trial_NN_sandboxrc_*_reward_*；结束后写 aaa_done_flag/"
      ]
    },
    {
      "dot": "rose",
      "title": "证据与不确定项",
      "items": [
        "G17 默认关闭：takeover 与仿真内采样都要求 CAPX_LIBERO_G17_FG=1",
        "OWL-ViT / SAM2 / cuRobo 仅在 full profile；CaP-RL 用独立 .venv-rl，未画入"
      ]
    }
  ]
