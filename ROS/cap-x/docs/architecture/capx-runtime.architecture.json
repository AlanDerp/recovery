  "cards": [
    {
      "dot": "cyan",
      "title": "运行与执行边界",
      "items": [
        "CLI 通过 spawn + 队列分派；每个 worker 复用环境。Web 使用协程与专用环境线程。",
        "生成代码在环境进程内执行；API 函数直接绑定到命名空间。"
      ]
    },
    {
      "dot": "emerald",
      "title": "可替换后端与共享服务",
      "items": [
        "底层可选 Robosuite、LIBERO、BEHAVIOR；真机经 TCP :9000 交换 MsgPack 观测与动作。",
        "YAML 自动启动或复用感知／规划服务；模型端点需单独启动，地址可配置。"
      ]
    },
    {
      "dot": "violet",
      "title": "多轮闭环与训练复用",
      "items": [
        "多轮根据执行反馈及可选图像／视频差分，再生成代码或 FINISH。",
        "独立 GRPO 训练通过 compute_score 调用同类环境的 step，奖励回传 VeRL。"
      ]
    }
  ]
